<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입</title>
</head>
<body>
<div class="container02">
 	<h2> 회원가입 </h2>
 	<form action="RequestJoinProc.jsp" method="post">
 		<table width="500" border="1">
 			<tr height="50">
 				<td align="center" width="150">아이디</td>
 				<td width="350">
 					<input type="text" name="id" placeholder="아이디를 입력하세요">
 				</td>
 			</tr>
 			<tr height="50">
 				<td align="center" width="150">비밀번호</td>
 				<td width="350">
 					<input type="password" name="pass" placeholder="영문과 숫자만 입력하세요">
 				</td>
 			</tr>
 			<tr height="50">
 				<td align="center" width="150">비밀번호 확인</td>
 				<td width="350">
 					<input type="password" name="passchk" placeholder="영문과 숫자만 입력하세요">
 				</td>
 			</tr>
 			<tr height="50">
 				<td align="center" width="150">Email</td>
 				<td width="350">
 					<input type="email" name="email" placeholder="@를 포함하여 입력하세요">
 				</td>
 			</tr>
 			
 		</table>
 	</form>
 </div>
</body>
</html>