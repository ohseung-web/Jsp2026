<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"  %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
		<!-- 구구단 2단 ~ 9단까지 모두 출력할 것  -->
		<h1>구구단</h1>
		<% for(int i=2; i<=9; i++){
			  for(int j=2; j<=9; j++){
		%>
		  	<%=j%>*<%=i%>=<%= i*j %>
		  	<%-- <%=i+"*"+j+"="+ i*j %><br/> --%>
		<% }%><br/>
		<% } %>
</body>
</html>